cGISFormat>1.0</ArcGISFormat><ArcGISstyle>FGDC CSDGM Metadata</ArcGISstyle><scaleRange><minScale>150000000</minScale><maxScale>5000</maxScale></scaleRange></Esri><mdChar><CharSetCd value="004"/></mdChar><mdHrLv><ScopeCd value="005"/></mdHrLv><dataIdInfo><idPurp>MassDEP Historic Combustion Facilities is a statewide point dataset containing former, inactive or closed Municipal Solid Waste Combustion Facilities.</idPurp><idAbs>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;The Department of Environmental Protection (MassDEP) Historic Combustion Facilities datalayer is a statewide point dataset containing former, inactive or demolished Municipal Solid Waste Combustion Facilities. The majority of these facilities did not have a resource recovery (energy generating) capacity to their combustion and were often referred to as municipal solid waste incinerators. These locations will not be found in the MassDEP Facilities with Air Operating Permits, Combustion Facilities or BWP Major Facilities datalayers. The layer name is BWP_PT_COMBUSTION_HISTORIC. For the locations of active municipal solid waste incinerators having a resource recovery component to their combustion, please see the BWP_PT_COMBUSTION layer.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;&lt;/DIV&gt;</idAbs><idCitation xmlns=""><resTitle>Municipal Solid Waste Combustion historic</resTitle><date><pubDate>2024-06-30T00:00:00</pubDate></date><citRespParty><rpOrgName>MA Department of Environmental Protection</rpOrgName><rpIndName>Bureau of Air and Waste</rpIndName><rpCntInfo><cntAddress addressType="postal"><delPoint>100 Cambridge St</delPoint><city>Boston</city><adminArea>MA</adminArea><postCode>02114</postCode><country>US</country></cntAddress><cntPhone><voiceNum tddtty="">617-292-5500</voiceNum></cntPhone></rpCntInfo><displayName>Bureau of Air and Waste</displayName><role><RoleCd value="006"/></role></citRespParty><presForm xmlns=""><PresFormCd value="005" Sync="TRUE"/></presFor